# =============================================================================
# HIGH SCHOOL YOUTH CLUB — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# =============================================================================
# BACKEND — SERVER
# =============================================================================
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# =============================================================================
# FRONTEND — NEXT.JS
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# MONGODB (MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
# =============================================================================
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@cluster0.mongodb.net/high_school_youth_club?retryWrites=true&w=majority
MONGODB_DB_NAME=high_school_youth_club

# =============================================================================
# SUPABASE AUTH
# Get from: https://app.supabase.com → Project Settings → API
# =============================================================================
# Backend (Service Role Key — NEVER expose to frontend)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Frontend (Anon/Public Key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# CLOUDINARY (Media Storage)
# Get from: https://cloudinary.com/console
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=high_school_youth_club_unsigned

# Frontend (safe to expose)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=high_school_youth_club_unsigned

# =============================================================================
# RESEND (Transactional Email)
# Get from: https://resend.com/api-keys
# =============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@highschoolyouthclub.org
RESEND_FROM_NAME=High School Youth Club

# =============================================================================
# SECURITY
# =============================================================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
FORM_RATE_LIMIT_MAX=5

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://highschoolyouthclub.org

# =============================================================================
# ADMIN
# =============================================================================
SUPER_ADMIN_EMAIL=admin@highschoolyouthclub.org
